#!/usr/bin/env bash
set -euo pipefail

DEFAULT_INSTALL_ROOT="__INSTALL_ROOT__"
# The installer substitutes the placeholder above; the split literal below keeps
# that substitution from also rewriting this comparison.
if [[ "${DEFAULT_INSTALL_ROOT}" == "__INSTALL""_ROOT__" ]]; then
  DEFAULT_INSTALL_ROOT="/opt/linxpanel"
fi

SERVICE_NAME="${LINXPANEL_SERVICE_NAME:-linxpanel}"
INSTALL_ROOT="${LINXPANEL_INSTALL_ROOT:-${DEFAULT_INSTALL_ROOT}}"
BIN_PATH="${LINXPANEL_BIN_PATH:-${INSTALL_ROOT}/bin/linxpanel}"
LOG_DIR="${LINXPANEL_LOG_DIR:-${INSTALL_ROOT}/logs}"
LOG_OUT="${LINXPANEL_LOG_OUT:-${LOG_DIR}/linxpanel.out.log}"
LOG_ERR="${LINXPANEL_LOG_ERR:-${LOG_DIR}/linxpanel.err.log}"
PID_FILE="${LINXPANEL_PID_FILE:-${INSTALL_ROOT}/linxpanel.pid}"
INSTALL_SCRIPT_URL="${LINXPANEL_INSTALL_SCRIPT_URL:-https://raw.githubusercontent.com/wdcodeku/LinxPanel-Rust/main/scripts/install.sh}"
GITHUB_PROXY="${LINXPANEL_GITHUB_PROXY:-}"

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

# Output follows the panel's language (switch with `Lp lang zh|en`); set by
# detect_lang before any command runs.
LP_LANG="en"

# Messages: printf templates by key, in the current language.
msg() {
  local key="$1"
  if [[ "${LP_LANG}" == "zh" ]]; then
    case "${key}" in
      need_root) echo "此操作需要 root 权限（未找到 sudo）。" ;;
      already_running) echo "LinxPanel 已在运行（PID：%s）。" ;;
      started) echo "LinxPanel 已启动（PID：%s）。" ;;
      start_failed) echo "LinxPanel 启动失败，请查看日志：%s" ;;
      not_running) echo "LinxPanel 未运行。" ;;
      stopped) echo "LinxPanel 已停止。" ;;
      running) echo "LinxPanel 正在运行（PID：%s）。" ;;
      url) echo "访问地址：%s" ;;
      no_journal) echo "systemd/journalctl 不可用，改为查看日志文件。" ;;
      unknown_log) echo "未知的日志类型：%s" ;;
      usage_logs) echo "用法：Lp logs [out|err|all|service]" ;;
      bad_update_mode) echo "不支持的更新方式：%s" ;;
      usage_update) echo "用法：Lp update [binary|build]" ;;
      need_curl) echo "更新需要 curl，请先安装。" ;;
      download_failed) echo "下载安装脚本失败：%s" ;;
      opened_ufw) echo "已在 ufw 中放行 %s/tcp。" ;;
      opened_firewalld) echo "已在 firewalld 中放行 %s/tcp。" ;;
      restarted) echo "LinxPanel 已重启。访问地址：%s" ;;
      resetting) echo "正在重置用户 '%s' 的密码..." ;;
      uninstall_what) echo "将删除 LinxPanel 的服务、程序和 Lp 命令。" ;;
      uninstall_purge) echo "--purge：%s 中的面板数据库、证书和日志也会一并删除。" ;;
      uninstall_keep) echo "%s/data 中的数据会保留（加 --purge 可一并删除）。" ;;
      confirm_yes) echo "输入 yes 继续：" ;;
      aborted) echo "已取消。" ;;
      uninstalled) echo "LinxPanel 已卸载。" ;;
      info_command) echo "命令：    Lp" ;;
      info_service) echo "服务名：  %s" ;;
      info_mode) echo "运行方式：%s" ;;
      info_root) echo "安装目录：%s" ;;
      info_binary) echo "程序：    %s" ;;
      info_logs) echo "日志：    %s | %s" ;;
      info_version) echo "版本：    %s" ;;
      info_port) echo "端口：    %s" ;;
      info_url) echo "访问地址：%s" ;;
      info_running) echo "状态：    运行中（PID：%s）" ;;
      info_stopped) echo "状态：    已停止" ;;
      security_url) echo "访问地址：  %s" ;;
      no_binary) echo "未找到 LinxPanel 程序：%s" ;;
      no_binary_tip) echo "提示：设置 LINXPANEL_INSTALL_ROOT，或执行：Lp update binary" ;;
      svc_enabled) echo "已设置开机自启。" ;;
      svc_disabled) echo "已取消开机自启。" ;;
      no_systemd) echo "systemd 不可用，跳过。" ;;
      unknown_cmd) echo "未知命令：%s" ;;
      *) echo "${key}" ;;
    esac
  else
    case "${key}" in
      need_root) echo "This action requires root privileges (sudo not found)." ;;
      already_running) echo "LinxPanel already running (PID: %s)." ;;
      started) echo "LinxPanel started (PID: %s)." ;;
      start_failed) echo "Failed to start LinxPanel. Check logs: %s" ;;
      not_running) echo "LinxPanel is not running." ;;
      stopped) echo "LinxPanel stopped." ;;
      running) echo "LinxPanel is running (PID: %s)." ;;
      url) echo "URL: %s" ;;
      no_journal) echo "systemd/journalctl not available; using file logs." ;;
      unknown_log) echo "Unknown log type: %s" ;;
      usage_logs) echo "Usage: Lp logs [out|err|all|service]" ;;
      bad_update_mode) echo "Unsupported update mode: %s" ;;
      usage_update) echo "Usage: Lp update [binary|build]" ;;
      need_curl) echo "curl is required for update command." ;;
      download_failed) echo "Failed to download installer: %s" ;;
      opened_ufw) echo "Opened %s/tcp in ufw." ;;
      opened_firewalld) echo "Opened %s/tcp in firewalld." ;;
      restarted) echo "LinxPanel restarted. URL: %s" ;;
      resetting) echo "Resetting password for '%s'..." ;;
      uninstall_what) echo "This removes the LinxPanel service, binary and Lp command." ;;
      uninstall_purge) echo "--purge: the panel database, certificates and logs in %s are deleted too." ;;
      uninstall_keep) echo "Data in %s/data is kept (use --purge to delete it)." ;;
      confirm_yes) echo "Type 'yes' to continue: " ;;
      aborted) echo "Aborted." ;;
      uninstalled) echo "LinxPanel uninstalled." ;;
      info_command) echo "Command: Lp" ;;
      info_service) echo "Service: %s" ;;
      info_mode) echo "Mode: %s" ;;
      info_root) echo "Install root: %s" ;;
      info_binary) echo "Binary: %s" ;;
      info_logs) echo "Logs: %s | %s" ;;
      info_version) echo "Version: %s" ;;
      info_port) echo "Port: %s" ;;
      info_url) echo "URL: %s" ;;
      info_running) echo "Status: running (PID: %s)" ;;
      info_stopped) echo "Status: stopped" ;;
      security_url) echo "URL:             %s" ;;
      no_binary) echo "LinxPanel binary not found: %s" ;;
      no_binary_tip) echo "Tip: set LINXPANEL_INSTALL_ROOT or run: Lp update binary" ;;
      svc_enabled) echo "systemd service enabled." ;;
      svc_disabled) echo "systemd service disabled." ;;
      no_systemd) echo "systemd not available, skip." ;;
      unknown_cmd) echo "Unknown command: %s" ;;
      *) echo "${key}" ;;
    esac
  fi
}

# say KEY [ARGS...]: one translated line on stdout; say_err: on stderr.
say() {
  local template
  template="$(msg "$1")"
  shift
  # shellcheck disable=SC2059 # templates come from msg(), not user input
  printf "${template}\n" "$@"
}

say_err() {
  say "$@" >&2
}

normalize_lang() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    zh* | cn | chinese | 中文) echo "zh" ;;
    en*) echo "en" ;;
    *) echo "" ;;
  esac
}

# The panel's language: LINXPANEL_LANG, else the panel setting (what the web
# UI uses), else the installer's choice, else the system locale.
detect_lang() {
  local value=""
  value="$(normalize_lang "${LINXPANEL_LANG:-}")"
  if [[ -z "${value}" && -x "${BIN_PATH}" ]]; then
    value="$(normalize_lang "$(panel_info language)")"
  fi
  if [[ -z "${value}" && -r "${INSTALL_ROOT}/install.conf" ]]; then
    value="$(normalize_lang "$(sed -n -E 's/^LANGUAGE=(.*)$/\1/p' "${INSTALL_ROOT}/install.conf" | head -n1)")"
  fi
  if [[ -z "${value}" ]]; then
    value="$(normalize_lang "${LC_ALL:-${LANG:-}}")"
  fi
  LP_LANG="${value:-en}"
}

# Keeps the installer's saved language in step, so upgrades speak it too.
save_install_lang() {
  local conf="${INSTALL_ROOT}/install.conf"
  if [[ -f "${conf}" ]] && grep -q '^LANGUAGE=' "${conf}"; then
    run_sudo sed -i -E "s/^LANGUAGE=.*/LANGUAGE=$1/" "${conf}"
  elif [[ -d "${INSTALL_ROOT}" ]]; then
    printf 'LANGUAGE=%s\n' "$1" | run_sudo tee -a "${conf}" >/dev/null
  fi
}

lang_cmd() {
  local value="${1:-show}"
  case "${value}" in
    show | status) ;;
    *)
      panel_cli lang "${value}" >/dev/null
      LP_LANG="$(normalize_lang "${value}")"
      save_install_lang "${LP_LANG}"
      ;;
  esac
  panel_cli lang show
}

run_sudo() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif has_cmd sudo; then
    sudo "$@"
  else
    say_err need_root
    exit 1
  fi
}

get_service_file() {
  local file=""
  for file in "/etc/systemd/system/${SERVICE_NAME}.service" "/lib/systemd/system/${SERVICE_NAME}.service"; do
    if [[ -f "${file}" ]]; then
      printf '%s' "${file}"
      return 0
    fi
  done
  return 1
}

read_service_value() {
  local key="$1"
  local service_file=""
  service_file="$(get_service_file || true)"
  if [[ -z "${service_file}" ]]; then
    return 1
  fi
  grep -E "^${key}=" "${service_file}" | head -n1 | cut -d= -f2- || true
}

read_service_env() {
  local key="$1"
  local service_file=""
  service_file="$(get_service_file || true)"
  if [[ -z "${service_file}" ]]; then
    return 1
  fi
  grep -E "^Environment=${key}=" "${service_file}" | head -n1 | sed -E "s/^Environment=${key}=//" || true
}

# Settings the installer saves for nohup mode, where there is no unit file to read.
read_env_file() {
  local key="$1"
  local env_file="${INSTALL_ROOT}/linxpanel.env"
  if [[ -f "${env_file}" ]]; then
    sed -n -E "s/^${key}=(.*)$/\1/p" "${env_file}" | head -n1
  fi
}

sync_paths_from_service() {
  local exec_start=""
  exec_start="$(read_service_value "ExecStart" || true)"
  if [[ -n "${exec_start}" && "${BIN_PATH}" == "${INSTALL_ROOT}/bin/linxpanel" ]]; then
    BIN_PATH="${exec_start}"
    INSTALL_ROOT="$(dirname "$(dirname "${BIN_PATH}")")"
    LOG_DIR="${INSTALL_ROOT}/logs"
    LOG_OUT="${LOG_DIR}/linxpanel.out.log"
    LOG_ERR="${LOG_DIR}/linxpanel.err.log"
    PID_FILE="${INSTALL_ROOT}/linxpanel.pid"
  fi
}

systemd_available() {
  if ! has_cmd systemctl; then
    return 1
  fi
  if systemctl list-unit-files 2>/dev/null | grep -q "^${SERVICE_NAME}\\.service"; then
    return 0
  fi
  get_service_file >/dev/null 2>&1
}

current_port() {
  local value=""
  value="${LINXPANEL_PORT:-}"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  # A port saved in the panel overrides the service's PORT, as in the binary.
  value="$(panel_info listen_port)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  service_port
}

# The PORT the service is started with: the fallback when none was saved in the panel.
service_port() {
  local value=""
  value="$(read_service_env "PORT" || true)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_env_file "PORT")"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  printf '%s' "7200"
}

current_database_url() {
  local value=""
  value="${LINXPANEL_DATABASE_URL:-}"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_service_env "DATABASE_URL" || true)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_env_file "DATABASE_URL")"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  printf '%s' "sqlite:${INSTALL_ROOT}/data/linxpanel.db?mode=rwc"
}

running_pids() {
  # Anchored so `Lp`, editors or `tail` on the binary path do not count as the panel.
  pgrep -f "^${BIN_PATH}( |$)" 2>/dev/null || true
}

is_running() {
  [[ -n "$(running_pids)" ]]
}

detect_ip() {
  local ip_candidate=""
  if [[ -n "${LINXPANEL_PUBLIC_IP:-}" ]]; then
    printf '%s' "${LINXPANEL_PUBLIC_IP}"
    return
  fi
  if has_cmd curl; then
    ip_candidate="$(curl -4fsS --connect-timeout 2 --max-time 4 https://api.ipify.org 2>/dev/null || true)"
    if [[ -n "${ip_candidate}" ]]; then
      printf '%s' "${ip_candidate}"
      return
    fi
  fi
  ip_candidate="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  if [[ -n "${ip_candidate}" ]]; then
    printf '%s' "${ip_candidate}"
    return
  fi
  printf '%s' "127.0.0.1"
}

start_no_systemd() {
  if is_running; then
    say already_running "$(running_pids | tr '\n' ' ')"
    return
  fi
  mkdir -p "${INSTALL_ROOT}/data" "${LOG_DIR}"
  nohup env \
    PORT="$(current_port)" \
    DATABASE_URL="$(current_database_url)" \
    "${BIN_PATH}" \
    >> "${LOG_OUT}" \
    2>> "${LOG_ERR}" &
  echo $! > "${PID_FILE}" || true
  sleep 1
  if is_running; then
    say started "$(running_pids | tr '\n' ' ')"
  else
    say_err start_failed "${LOG_ERR}"
    exit 1
  fi
}

stop_no_systemd() {
  local pids=""
  pids="$(running_pids)"
  if [[ -z "${pids}" ]]; then
    say not_running
    rm -f "${PID_FILE}" || true
    return
  fi
  echo "${pids}" | xargs -r kill -TERM || true
  sleep 1
  pids="$(running_pids)"
  if [[ -n "${pids}" ]]; then
    echo "${pids}" | xargs -r kill -KILL || true
  fi
  rm -f "${PID_FILE}" || true
  say stopped
}

status_cmd() {
  if systemd_available; then
    systemctl status "${SERVICE_NAME}" --no-pager || true
    return
  fi
  if is_running; then
    say running "$(running_pids | tr '\n' ' ')"
    say url "$(panel_url)"
  else
    say not_running
  fi
}

logs_cmd() {
  local kind="${1:-out}"
  # Older systemd (< 240) cannot append to files, so the panel logs to journald there.
  if [[ "${kind}" != "service" && ! -f "${LOG_OUT}" && ! -f "${LOG_ERR}" ]] \
    && systemd_available && has_cmd journalctl; then
    kind="service"
  fi
  case "${kind}" in
    out) tail -f "${LOG_OUT}" ;;
    err) tail -f "${LOG_ERR}" ;;
    all) tail -f "${LOG_OUT}" "${LOG_ERR}" ;;
    service)
      if systemd_available && has_cmd journalctl; then
        run_sudo journalctl -u "${SERVICE_NAME}" -f -n 100
      else
        say no_journal
        tail -f "${LOG_OUT}" "${LOG_ERR}"
      fi
      ;;
    *)
      say_err unknown_log "${kind}"
      say_err usage_logs
      exit 1
      ;;
  esac
}

update_cmd() {
  local mode="${1:-binary}"
  case "${mode}" in
    binary|build) ;;
    *)
      say_err bad_update_mode "${mode}"
      say_err usage_update
      exit 1
      ;;
  esac
  if ! has_cmd curl; then
    say_err need_curl
    exit 1
  fi
  local script=""
  if ! script="$(curl -fsSL --retry 3 --connect-timeout 10 "${GITHUB_PROXY}${INSTALL_SCRIPT_URL}")" \
    || [[ -z "${script}" ]]; then
    say_err download_failed "${INSTALL_SCRIPT_URL}"
    exit 1
  fi
  env \
    LINXPANEL_INSTALL_ROOT="${INSTALL_ROOT}" \
    LINXPANEL_PORT="$(current_port)" \
    LINXPANEL_INSTALL_MODE="${mode}" \
    LINXPANEL_LANG="${LP_LANG}" \
    bash -c "${script}"
}

# Runs a `linxpanel` subcommand against the installed database.
panel_cli() {
  run_sudo env \
    DATABASE_URL="$(current_database_url)" \
    PORT="$(service_port)" \
    RUST_LOG=error \
    LINXPANEL_LANG="${LP_LANG}" \
    "${BIN_PATH}" "$@"
}

# A key from `linxpanel info`; empty on binaries that predate the command.
# Those ignore unknown arguments and start the server, hence the timeout.
panel_info() {
  local timeout_cmd=()
  has_cmd timeout && timeout_cmd=(timeout 5)
  run_sudo env DATABASE_URL="$(current_database_url)" RUST_LOG=error \
    ${timeout_cmd[@]+"${timeout_cmd[@]}"} "${BIN_PATH}" info 2>/dev/null \
    | sed -n -E "s/^$1=(.*)$/\1/p" | head -n1 || true
}

# Subcommands run as root; keep the data owned by the service account.
fix_data_owner() {
  local owner=""
  owner="$(read_service_value "User" || true)"
  if [[ -n "${owner}" ]]; then
    run_sudo chown -R "${owner}" "${INSTALL_ROOT}/data" 2>/dev/null || true
  fi
}

panel_url() {
  local scheme=""
  local host=""
  scheme="$(panel_info scheme)"
  # A bound domain is the only host the panel answers to.
  host="$(panel_info domain)"
  printf '%s://%s:%s%s' "${scheme:-http}" "${host:-$(detect_ip)}" "$(current_port)" "$(panel_info entrance)"
}

# Allows a port in an active ufw / firewalld, best effort.
open_firewall_port() {
  local port="$1"
  if has_cmd ufw && run_sudo ufw status 2>/dev/null | grep -q "Status: active"; then
    run_sudo ufw allow "${port}/tcp" >/dev/null 2>&1 && say opened_ufw "${port}"
  elif has_cmd firewall-cmd && run_sudo firewall-cmd --state >/dev/null 2>&1; then
    run_sudo firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 \
      && run_sudo firewall-cmd --reload >/dev/null 2>&1 \
      && say opened_firewalld "${port}"
  fi
}

# `Lp port|allow-ip|domain ...`: show, or change and restart to apply.
access_cmd() {
  local command="$1"
  shift
  local action="${1:-show}"
  panel_cli "${command}" "$@" | grep -v -e "^Restart the panel" -e "^重启面板后生效"
  fix_data_owner
  case "${action}" in
    show | status) return ;;
  esac
  if [[ "${command}" == "port" && "${action}" =~ ^[0-9]+$ ]]; then
    open_firewall_port "${action}"
  fi
  apply_restart
}

# Restarts the panel so entrance / HTTPS changes take effect.
apply_restart() {
  if systemd_available; then
    run_sudo systemctl restart "${SERVICE_NAME}"
  elif is_running; then
    stop_no_systemd
    start_no_systemd
  else
    return
  fi
  say restarted "$(panel_url)"
}

entrance_cmd() {
  local action="${1:-show}"
  panel_cli entrance "$@" | grep -v -e "^Restart the panel" -e "^重启面板后生效"
  fix_data_owner
  if [[ "${action}" != "show" && "${action}" != "status" ]]; then
    apply_restart
  fi
}

ssl_cmd() {
  local action="${1:-status}"
  panel_cli ssl "$@" | grep -v -e "^Restart the panel" -e "^重启面板后生效"
  fix_data_owner
  if [[ "${action}" != "status" ]]; then
    apply_restart
  fi
}

reset_password_cmd() {
  local user="${1:-}"
  [[ -z "${user}" ]] && user="$(panel_info admin_user)"
  user="${user:-admin}"
  say resetting "${user}"
  panel_cli reset-password --user "${user}"
  fix_data_owner
}

uninstall_cmd() {
  local purge="${1:-}"
  say uninstall_what
  if [[ "${purge}" == "--purge" ]]; then
    say uninstall_purge "${INSTALL_ROOT}"
  else
    say uninstall_keep "${INSTALL_ROOT}"
  fi
  local answer=""
  read -r -p "$(msg confirm_yes)" answer || true
  if [[ "${answer}" != "yes" ]]; then
    say aborted
    exit 1
  fi
  if systemd_available; then
    run_sudo systemctl disable --now "${SERVICE_NAME}" >/dev/null 2>&1 || true
    local service_file=""
    service_file="$(get_service_file || true)"
    [[ -n "${service_file}" ]] && run_sudo rm -f "${service_file}"
    run_sudo systemctl daemon-reload || true
  else
    stop_no_systemd
  fi
  run_sudo rm -f /etc/logrotate.d/linxpanel
  # Kernel bans would otherwise keep dropping traffic with nothing left to lift them.
  if command -v nft >/dev/null 2>&1; then
    run_sudo nft delete table inet linxpanel >/dev/null 2>&1 || true
  fi
  # Values stay until reboot; then the distro defaults return.
  run_sudo rm -f /etc/sysctl.d/90-linxpanel.conf
  if [[ "${purge}" == "--purge" ]]; then
    run_sudo rm -rf "${INSTALL_ROOT}"
  else
    run_sudo rm -rf "${INSTALL_ROOT}/bin" "${INSTALL_ROOT}/backup"
  fi
  run_sudo rm -f /usr/local/bin/Lp /usr/local/bin/lp
  say uninstalled
}

info_cmd() {
  local mode="nohup"
  if systemd_available; then
    mode="systemd"
  fi
  say info_command
  say info_service "${SERVICE_NAME}"
  say info_mode "${mode}"
  say info_root "${INSTALL_ROOT}"
  say info_binary "${BIN_PATH}"
  say info_logs "${LOG_OUT}" "${LOG_ERR}"
  say info_version "$(version_text)"
  say info_port "$(current_port)"
  say info_url "$(panel_url)"
  if is_running; then
    say info_running "$(running_pids | tr '\n' ' ')"
  else
    say info_stopped
  fi
}

version_text() {
  if has_cmd timeout; then
    timeout 5 "${BIN_PATH}" --version 2>/dev/null | awk '/^linxpanel / {print $2}' || true
  else
    "${BIN_PATH}" --version 2>/dev/null | awk '/^linxpanel / {print $2}' || true
  fi
}

print_help() {
  if [[ "${LP_LANG}" == "zh" ]]; then
    cat <<'EOF'
Lp - LinxPanel 命令行工具

用法：
  Lp status                 查看服务状态
  Lp start                  启动面板
  Lp stop                   停止面板
  Lp restart                重启面板
  Lp logs [out|err|all|service]
                            查看日志
  Lp info                   查看运行信息
  Lp update [binary|build]  升级/重装面板（数据保留）
  Lp reset-password [用户]  重置为随机密码（默认为面板账号）
  Lp entrance [show|off|random|/路径]
                            查看或修改安全入口
  Lp ssl [status|on|off]    查看或修改面板 HTTPS（默认自签名证书）
  Lp port [端口|default]    查看或修改面板端口
  Lp allow-ip [off|IP ...]  查看、设置或清除授权访问 IP/网段
  Lp domain [off|域名]      查看、设置或清除绑定域名
  Lp mfa [off] [用户]       查看或关闭两步验证
  Lp security               查看全部面板安全设置
  Lp lang [zh|en]           查看或切换语言（面板和命令行一起切换）
  Lp bans                   列出被主动防御封禁的地址
  Lp ban IP [分钟]          封禁某个地址的全部流量（0 为永久）
  Lp unban IP|all           解除封禁（all：全部解除，例如误封了自己）
  Lp defense [on|off]       查看或开关自动封禁
  Lp harden [on|off]        内核网络加固（SYN Cookie 等）
  Lp version                查看已安装版本
  Lp enable                 设置开机自启
  Lp disable                取消开机自启
  Lp uninstall [--purge]    卸载面板（--purge 同时删除数据）
  Lp help                   显示本帮助
EOF
    return
  fi
  cat <<'EOF'
Lp - LinxPanel CLI

Usage:
  Lp status                 Show service status
  Lp start                  Start LinxPanel
  Lp stop                   Stop LinxPanel
  Lp restart                Restart LinxPanel
  Lp logs [out|err|all|service]
                            View logs
  Lp info                   Show runtime info
  Lp update [binary|build]  Upgrade/reinstall LinxPanel (data is kept)
  Lp reset-password [user]  Set a new random password (default: the panel's account)
  Lp entrance [show|off|random|/path]
                            Show or change the security entrance
  Lp ssl [status|on|off]    Show or change panel HTTPS (self-signed by default)
  Lp port [PORT|default]    Show or change the panel port
  Lp allow-ip [off|IP ...]  Show, set or clear the allowed client IPs/CIDRs
  Lp domain [off|DOMAIN]    Show, set or clear the bound domain
  Lp mfa [off] [user]       Show or turn off two-factor login
  Lp security               Show all panel security settings
  Lp lang [zh|en]           Show or switch the language (panel and CLI together)
  Lp bans                   List addresses banned by active defense
  Lp ban IP [MINUTES]       Drop all traffic from an address (0 = permanent)
  Lp unban IP|all           Lift a ban (all: e.g. after locking yourself out)
  Lp defense [on|off]       Show or switch automatic banning
  Lp harden [on|off]        Kernel network hardening (SYN cookies etc.)
  Lp version                Show installed version
  Lp enable                 Enable systemd service
  Lp disable                Disable systemd service
  Lp uninstall [--purge]    Remove LinxPanel (--purge also deletes data)
  Lp help                   Show this help
EOF
}

sync_paths_from_service
detect_lang

cmd="${1:-help}"

require_binary=0
case "${cmd}" in
  start|restart|logs|info|reset-password|version|entrance|ssl|port|allow-ip|domain|mfa|security|lang|ban|unban|bans|defense|harden)
    require_binary=1
    ;;
esac

if [[ "${require_binary}" == "1" && ! -x "${BIN_PATH}" ]]; then
  say_err no_binary "${BIN_PATH}"
  say_err no_binary_tip
  exit 1
fi

case "${cmd}" in
  start)
    if systemd_available; then
      run_sudo systemctl start "${SERVICE_NAME}"
      status_cmd
    else
      start_no_systemd
    fi
    ;;
  stop)
    if systemd_available; then
      run_sudo systemctl stop "${SERVICE_NAME}"
      say stopped
    else
      stop_no_systemd
    fi
    ;;
  restart)
    if systemd_available; then
      run_sudo systemctl restart "${SERVICE_NAME}"
      status_cmd
    else
      stop_no_systemd
      start_no_systemd
    fi
    ;;
  status)
    status_cmd
    ;;
  logs)
    logs_cmd "${2:-out}"
    ;;
  info)
    info_cmd
    ;;
  update)
    update_cmd "${2:-binary}"
    ;;
  port|allow-ip|domain)
    access_cmd "$@"
    ;;
  mfa)
    if [[ "${2:-status}" == "off" ]]; then
      mfa_user="${3:-$(panel_info admin_user)}"
      panel_cli mfa off --user "${mfa_user:-admin}"
    else
      panel_cli mfa status ${3:+--user "$3"}
    fi
    ;;
  # Bans and defense switches apply at once: the kernel set changes now and the
  # running panel re-reads its settings every few seconds.
  ban|unban|bans|defense|harden)
    panel_cli "$@"
    ;;
  security)
    panel_cli security
    say security_url "$(panel_url)"
    ;;
  lang | language)
    lang_cmd "${2:-show}"
    ;;
  entrance)
    shift
    entrance_cmd "$@"
    ;;
  ssl)
    shift
    ssl_cmd "$@"
    ;;
  reset-password|resetpwd)
    reset_password_cmd "${2:-}"
    ;;
  version|-v|--version)
    echo "LinxPanel $(version_text)"
    ;;
  uninstall)
    uninstall_cmd "${2:-}"
    ;;
  enable)
    if systemd_available; then
      run_sudo systemctl enable "${SERVICE_NAME}"
      say svc_enabled
    else
      say no_systemd
    fi
    ;;
  disable)
    if systemd_available; then
      run_sudo systemctl disable "${SERVICE_NAME}"
      say svc_disabled
    else
      say no_systemd
    fi
    ;;
  help|-h|--help)
    print_help
    ;;
  *)
    say_err unknown_cmd "${cmd}"
    print_help
    exit 1
    ;;
esac
