#!/usr/bin/env bash
set -euo pipefail

DEFAULT_INSTALL_ROOT="__INSTALL_ROOT__"
# The installer substitutes the placeholder above; the split literal below keeps
# that substitution from also rewriting this comparison.
if [[ "${DEFAULT_INSTALL_ROOT}" == "__INSTALL""_ROOT__" ]]; then
  DEFAULT_INSTALL_ROOT="/opt/linxpanel"
fi

SERVICE_NAME="${LINXPANEL_SERVICE_NAME:-linxpanel}"
INSTALL_ROOT="${LINXPANEL_INSTALL_ROOT:-${DEFAULT_INSTALL_ROOT}}"
BIN_PATH="${LINXPANEL_BIN_PATH:-${INSTALL_ROOT}/bin/linxpanel}"
LOG_DIR="${LINXPANEL_LOG_DIR:-${INSTALL_ROOT}/logs}"
LOG_OUT="${LINXPANEL_LOG_OUT:-${LOG_DIR}/linxpanel.out.log}"
LOG_ERR="${LINXPANEL_LOG_ERR:-${LOG_DIR}/linxpanel.err.log}"
PID_FILE="${LINXPANEL_PID_FILE:-${INSTALL_ROOT}/linxpanel.pid}"
INSTALL_SCRIPT_URL="${LINXPANEL_INSTALL_SCRIPT_URL:-https://raw.githubusercontent.com/wdcodeku/LinxPanel-Rust/main/scripts/install.sh}"
GITHUB_PROXY="${LINXPANEL_GITHUB_PROXY:-}"

has_cmd() {
  command -v "$1" >/dev/null 2>&1
}

run_sudo() {
  if [[ "$(id -u)" -eq 0 ]]; then
    "$@"
  elif has_cmd sudo; then
    sudo "$@"
  else
    echo "This action requires root privileges (sudo not found)." >&2
    exit 1
  fi
}

get_service_file() {
  local file=""
  for file in "/etc/systemd/system/${SERVICE_NAME}.service" "/lib/systemd/system/${SERVICE_NAME}.service"; do
    if [[ -f "${file}" ]]; then
      printf '%s' "${file}"
      return 0
    fi
  done
  return 1
}

read_service_value() {
  local key="$1"
  local service_file=""
  service_file="$(get_service_file || true)"
  if [[ -z "${service_file}" ]]; then
    return 1
  fi
  grep -E "^${key}=" "${service_file}" | head -n1 | cut -d= -f2- || true
}

read_service_env() {
  local key="$1"
  local service_file=""
  service_file="$(get_service_file || true)"
  if [[ -z "${service_file}" ]]; then
    return 1
  fi
  grep -E "^Environment=${key}=" "${service_file}" | head -n1 | sed -E "s/^Environment=${key}=//" || true
}

# Settings the installer saves for nohup mode, where there is no unit file to read.
read_env_file() {
  local key="$1"
  local env_file="${INSTALL_ROOT}/linxpanel.env"
  if [[ -f "${env_file}" ]]; then
    sed -n -E "s/^${key}=(.*)$/\1/p" "${env_file}" | head -n1
  fi
}

sync_paths_from_service() {
  local exec_start=""
  exec_start="$(read_service_value "ExecStart" || true)"
  if [[ -n "${exec_start}" && "${BIN_PATH}" == "${INSTALL_ROOT}/bin/linxpanel" ]]; then
    BIN_PATH="${exec_start}"
    INSTALL_ROOT="$(dirname "$(dirname "${BIN_PATH}")")"
    LOG_DIR="${INSTALL_ROOT}/logs"
    LOG_OUT="${LOG_DIR}/linxpanel.out.log"
    LOG_ERR="${LOG_DIR}/linxpanel.err.log"
    PID_FILE="${INSTALL_ROOT}/linxpanel.pid"
  fi
}

systemd_available() {
  if ! has_cmd systemctl; then
    return 1
  fi
  if systemctl list-unit-files 2>/dev/null | grep -q "^${SERVICE_NAME}\\.service"; then
    return 0
  fi
  get_service_file >/dev/null 2>&1
}

current_port() {
  local value=""
  value="${LINXPANEL_PORT:-}"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  # A port saved in the panel overrides the service's PORT, as in the binary.
  value="$(panel_info listen_port)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  service_port
}

# The PORT the service is started with: the fallback when none was saved in the panel.
service_port() {
  local value=""
  value="$(read_service_env "PORT" || true)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_env_file "PORT")"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  printf '%s' "7200"
}

current_database_url() {
  local value=""
  value="${LINXPANEL_DATABASE_URL:-}"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_service_env "DATABASE_URL" || true)"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  value="$(read_env_file "DATABASE_URL")"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  printf '%s' "sqlite:${INSTALL_ROOT}/data/linxpanel.db?mode=rwc"
}

running_pids() {
  # Anchored so `Lp`, editors or `tail` on the binary path do not count as the panel.
  pgrep -f "^${BIN_PATH}( |$)" 2>/dev/null || true
}

is_running() {
  [[ -n "$(running_pids)" ]]
}

detect_ip() {
  local ip_candidate=""
  if [[ -n "${LINXPANEL_PUBLIC_IP:-}" ]]; then
    printf '%s' "${LINXPANEL_PUBLIC_IP}"
    return
  fi
  if has_cmd curl; then
    ip_candidate="$(curl -4fsS --connect-timeout 2 --max-time 4 https://api.ipify.org 2>/dev/null || true)"
    if [[ -n "${ip_candidate}" ]]; then
      printf '%s' "${ip_candidate}"
      return
    fi
  fi
  ip_candidate="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  if [[ -n "${ip_candidate}" ]]; then
    printf '%s' "${ip_candidate}"
    return
  fi
  printf '%s' "127.0.0.1"
}

start_no_systemd() {
  if is_running; then
    echo "LinxPanel already running (PID: $(running_pids | tr '\n' ' '))."
    return
  fi
  mkdir -p "${INSTALL_ROOT}/data" "${LOG_DIR}"
  nohup env \
    PORT="$(current_port)" \
    DATABASE_URL="$(current_database_url)" \
    "${BIN_PATH}" \
    >> "${LOG_OUT}" \
    2>> "${LOG_ERR}" &
  echo $! > "${PID_FILE}" || true
  sleep 1
  if is_running; then
    echo "LinxPanel started (PID: $(running_pids | tr '\n' ' '))."
  else
    echo "Failed to start LinxPanel. Check logs: ${LOG_ERR}" >&2
    exit 1
  fi
}

stop_no_systemd() {
  local pids=""
  pids="$(running_pids)"
  if [[ -z "${pids}" ]]; then
    echo "LinxPanel is not running."
    rm -f "${PID_FILE}" || true
    return
  fi
  echo "${pids}" | xargs -r kill -TERM || true
  sleep 1
  pids="$(running_pids)"
  if [[ -n "${pids}" ]]; then
    echo "${pids}" | xargs -r kill -KILL || true
  fi
  rm -f "${PID_FILE}" || true
  echo "LinxPanel stopped."
}

status_cmd() {
  if systemd_available; then
    systemctl status "${SERVICE_NAME}" --no-pager || true
    return
  fi
  if is_running; then
    echo "LinxPanel is running (PID: $(running_pids | tr '\n' ' '))."
    echo "URL: $(panel_url)"
  else
    echo "LinxPanel is not running."
  fi
}

logs_cmd() {
  local kind="${1:-out}"
  # Older systemd (< 240) cannot append to files, so the panel logs to journald there.
  if [[ "${kind}" != "service" && ! -f "${LOG_OUT}" && ! -f "${LOG_ERR}" ]] \
    && systemd_available && has_cmd journalctl; then
    kind="service"
  fi
  case "${kind}" in
    out) tail -f "${LOG_OUT}" ;;
    err) tail -f "${LOG_ERR}" ;;
    all) tail -f "${LOG_OUT}" "${LOG_ERR}" ;;
    service)
      if systemd_available && has_cmd journalctl; then
        run_sudo journalctl -u "${SERVICE_NAME}" -f -n 100
      else
        echo "systemd/journalctl not available; using file logs."
        tail -f "${LOG_OUT}" "${LOG_ERR}"
      fi
      ;;
    *)
      echo "Unknown log type: ${kind}" >&2
      echo "Usage: Lp logs [out|err|all|service]" >&2
      exit 1
      ;;
  esac
}

update_cmd() {
  local mode="${1:-binary}"
  case "${mode}" in
    binary|build) ;;
    *)
      echo "Unsupported update mode: ${mode}" >&2
      echo "Usage: Lp update [binary|build]" >&2
      exit 1
      ;;
  esac
  if ! has_cmd curl; then
    echo "curl is required for update command." >&2
    exit 1
  fi
  local script=""
  if ! script="$(curl -fsSL --retry 3 --connect-timeout 10 "${GITHUB_PROXY}${INSTALL_SCRIPT_URL}")" \
    || [[ -z "${script}" ]]; then
    echo "Failed to download installer: ${INSTALL_SCRIPT_URL}" >&2
    exit 1
  fi
  env \
    LINXPANEL_INSTALL_ROOT="${INSTALL_ROOT}" \
    LINXPANEL_PORT="$(current_port)" \
    LINXPANEL_INSTALL_MODE="${mode}" \
    bash -c "${script}"
}

# Runs a `linxpanel` subcommand against the installed database.
panel_cli() {
  run_sudo env \
    DATABASE_URL="$(current_database_url)" \
    PORT="$(service_port)" \
    RUST_LOG=error \
    "${BIN_PATH}" "$@"
}

# A key from `linxpanel info`; empty on binaries that predate the command.
# Those ignore unknown arguments and start the server, hence the timeout.
panel_info() {
  local timeout_cmd=()
  has_cmd timeout && timeout_cmd=(timeout 5)
  run_sudo env DATABASE_URL="$(current_database_url)" RUST_LOG=error \
    ${timeout_cmd[@]+"${timeout_cmd[@]}"} "${BIN_PATH}" info 2>/dev/null \
    | sed -n -E "s/^$1=(.*)$/\1/p" | head -n1 || true
}

# Subcommands run as root; keep the data owned by the service account.
fix_data_owner() {
  local owner=""
  owner="$(read_service_value "User" || true)"
  if [[ -n "${owner}" ]]; then
    run_sudo chown -R "${owner}" "${INSTALL_ROOT}/data" 2>/dev/null || true
  fi
}

panel_url() {
  local scheme=""
  local host=""
  scheme="$(panel_info scheme)"
  # A bound domain is the only host the panel answers to.
  host="$(panel_info domain)"
  printf '%s://%s:%s%s' "${scheme:-http}" "${host:-$(detect_ip)}" "$(current_port)" "$(panel_info entrance)"
}

# Allows a port in an active ufw / firewalld, best effort.
open_firewall_port() {
  local port="$1"
  if has_cmd ufw && run_sudo ufw status 2>/dev/null | grep -q "Status: active"; then
    run_sudo ufw allow "${port}/tcp" >/dev/null 2>&1 && echo "Opened ${port}/tcp in ufw."
  elif has_cmd firewall-cmd && run_sudo firewall-cmd --state >/dev/null 2>&1; then
    run_sudo firewall-cmd --permanent --add-port="${port}/tcp" >/dev/null 2>&1 \
      && run_sudo firewall-cmd --reload >/dev/null 2>&1 \
      && echo "Opened ${port}/tcp in firewalld."
  fi
}

# `Lp port|allow-ip|domain ...`: show, or change and restart to apply.
access_cmd() {
  local command="$1"
  shift
  local action="${1:-show}"
  panel_cli "${command}" "$@" | grep -v "^Restart the panel"
  fix_data_owner
  case "${action}" in
    show | status) return ;;
  esac
  if [[ "${command}" == "port" && "${action}" =~ ^[0-9]+$ ]]; then
    open_firewall_port "${action}"
  fi
  apply_restart
}

# Restarts the panel so entrance / HTTPS changes take effect.
apply_restart() {
  if systemd_available; then
    run_sudo systemctl restart "${SERVICE_NAME}"
  elif is_running; then
    stop_no_systemd
    start_no_systemd
  else
    return
  fi
  echo "LinxPanel restarted. URL: $(panel_url)"
}

entrance_cmd() {
  local action="${1:-show}"
  panel_cli entrance "$@" | grep -v "^Restart the panel"
  fix_data_owner
  if [[ "${action}" != "show" && "${action}" != "status" ]]; then
    apply_restart
  fi
}

ssl_cmd() {
  local action="${1:-status}"
  panel_cli ssl "$@" | grep -v "^Restart the panel"
  fix_data_owner
  if [[ "${action}" != "status" ]]; then
    apply_restart
  fi
}

reset_password_cmd() {
  local user="${1:-}"
  [[ -z "${user}" ]] && user="$(panel_info admin_user)"
  user="${user:-admin}"
  echo "Resetting password for '${user}'..."
  panel_cli reset-password --user "${user}"
  fix_data_owner
}

uninstall_cmd() {
  local purge="${1:-}"
  echo "This removes the LinxPanel service, binary and Lp command."
  if [[ "${purge}" == "--purge" ]]; then
    echo "--purge: the panel database, certificates and logs in ${INSTALL_ROOT} are deleted too."
  else
    echo "Data in ${INSTALL_ROOT}/data is kept (use --purge to delete it)."
  fi
  local answer=""
  read -r -p "Type 'yes' to continue: " answer || true
  if [[ "${answer}" != "yes" ]]; then
    echo "Aborted."
    exit 1
  fi
  if systemd_available; then
    run_sudo systemctl disable --now "${SERVICE_NAME}" >/dev/null 2>&1 || true
    local service_file=""
    service_file="$(get_service_file || true)"
    [[ -n "${service_file}" ]] && run_sudo rm -f "${service_file}"
    run_sudo systemctl daemon-reload || true
  else
    stop_no_systemd
  fi
  run_sudo rm -f /etc/logrotate.d/linxpanel
  if [[ "${purge}" == "--purge" ]]; then
    run_sudo rm -rf "${INSTALL_ROOT}"
  else
    run_sudo rm -rf "${INSTALL_ROOT}/bin" "${INSTALL_ROOT}/backup"
  fi
  run_sudo rm -f /usr/local/bin/Lp /usr/local/bin/lp
  echo "LinxPanel uninstalled."
}

info_cmd() {
  local mode="nohup"
  if systemd_available; then
    mode="systemd"
  fi
  echo "Command: Lp"
  echo "Service: ${SERVICE_NAME}"
  echo "Mode: ${mode}"
  echo "Install root: ${INSTALL_ROOT}"
  echo "Binary: ${BIN_PATH}"
  echo "Logs: ${LOG_OUT} | ${LOG_ERR}"
  echo "Version: $(version_text)"
  echo "Port: $(current_port)"
  echo "URL: $(panel_url)"
  if is_running; then
    echo "Status: running (PID: $(running_pids | tr '\n' ' '))"
  else
    echo "Status: stopped"
  fi
}

version_text() {
  if has_cmd timeout; then
    timeout 5 "${BIN_PATH}" --version 2>/dev/null | awk '/^linxpanel / {print $2}' || true
  else
    "${BIN_PATH}" --version 2>/dev/null | awk '/^linxpanel / {print $2}' || true
  fi
}

print_help() {
  cat <<'EOF'
Lp - LinxPanel CLI

Usage:
  Lp status                 Show service status
  Lp start                  Start LinxPanel
  Lp stop                   Stop LinxPanel
  Lp restart                Restart LinxPanel
  Lp logs [out|err|all|service]
                            View logs
  Lp info                   Show runtime info
  Lp update [binary|build]  Upgrade/reinstall LinxPanel (data is kept)
  Lp reset-password [user]  Set a new random password (default: the panel's account)
  Lp entrance [show|off|random|/path]
                            Show or change the security entrance
  Lp ssl [status|on|off]    Show or change panel HTTPS (self-signed by default)
  Lp port [PORT|default]    Show or change the panel port
  Lp allow-ip [off|IP ...]  Show, set or clear the allowed client IPs/CIDRs
  Lp domain [off|DOMAIN]    Show, set or clear the bound domain
  Lp mfa [off] [user]       Show or turn off two-factor login
  Lp security               Show all panel security settings
  Lp version                Show installed version
  Lp enable                 Enable systemd service
  Lp disable                Disable systemd service
  Lp uninstall [--purge]    Remove LinxPanel (--purge also deletes data)
  Lp help                   Show this help
EOF
}

sync_paths_from_service

cmd="${1:-help}"

require_binary=0
case "${cmd}" in
  start|restart|logs|info|reset-password|version|entrance|ssl|port|allow-ip|domain|mfa|security)
    require_binary=1
    ;;
esac

if [[ "${require_binary}" == "1" && ! -x "${BIN_PATH}" ]]; then
  echo "LinxPanel binary not found: ${BIN_PATH}" >&2
  echo "Tip: set LINXPANEL_INSTALL_ROOT or run: Lp update binary" >&2
  exit 1
fi

case "${cmd}" in
  start)
    if systemd_available; then
      run_sudo systemctl start "${SERVICE_NAME}"
      status_cmd
    else
      start_no_systemd
    fi
    ;;
  stop)
    if systemd_available; then
      run_sudo systemctl stop "${SERVICE_NAME}"
      echo "LinxPanel stopped."
    else
      stop_no_systemd
    fi
    ;;
  restart)
    if systemd_available; then
      run_sudo systemctl restart "${SERVICE_NAME}"
      status_cmd
    else
      stop_no_systemd
      start_no_systemd
    fi
    ;;
  status)
    status_cmd
    ;;
  logs)
    logs_cmd "${2:-out}"
    ;;
  info)
    info_cmd
    ;;
  update)
    update_cmd "${2:-binary}"
    ;;
  port|allow-ip|domain)
    access_cmd "$@"
    ;;
  mfa)
    if [[ "${2:-status}" == "off" ]]; then
      mfa_user="${3:-$(panel_info admin_user)}"
      panel_cli mfa off --user "${mfa_user:-admin}"
    else
      panel_cli mfa status ${3:+--user "$3"}
    fi
    ;;
  security)
    panel_cli security
    echo "URL:             $(panel_url)"
    ;;
  entrance)
    shift
    entrance_cmd "$@"
    ;;
  ssl)
    shift
    ssl_cmd "$@"
    ;;
  reset-password|resetpwd)
    reset_password_cmd "${2:-}"
    ;;
  version|-v|--version)
    echo "LinxPanel $(version_text)"
    ;;
  uninstall)
    uninstall_cmd "${2:-}"
    ;;
  enable)
    if systemd_available; then
      run_sudo systemctl enable "${SERVICE_NAME}"
      echo "systemd service enabled."
    else
      echo "systemd not available, skip."
    fi
    ;;
  disable)
    if systemd_available; then
      run_sudo systemctl disable "${SERVICE_NAME}"
      echo "systemd service disabled."
    else
      echo "systemd not available, skip."
    fi
    ;;
  help|-h|--help)
    print_help
    ;;
  *)
    echo "Unknown command: ${cmd}" >&2
    print_help
    exit 1
    ;;
esac
